<Window x:Class="BiliIndexTranslate.App.Onboarding.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bili Index Translate"
        Style="{StaticResource UiWindow}"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
  <StackPanel Margin="26,22,26,20">
    <TextBlock Text="A quiet reading companion" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Ui.TextSecondary}"
               Text="Select text in another program. A small card with the Chinese translation appears above the selection, and goes away when you click elsewhere, clear the selection, or press Esc. Nothing stays on screen otherwise." />

    <TextBlock Margin="0,18,0,6" Text="Try it here — select a few words:" FontWeight="SemiBold" />
    <TextBox x:Name="DemoBox" IsReadOnly="True" TextWrapping="Wrap" Padding="12" FontSize="14" TextBlock.LineHeight="24"
             Background="{DynamicResource Ui.Panel}" Foreground="{DynamicResource Ui.Text}" BorderBrush="{DynamicResource Ui.Border}"
             AutomationProperties.Name="Demo text"
             Text="Reading in another language should feel effortless. Select this sentence with the mouse, release the button, and wait a moment. Then click anywhere else to let the card disappear." />

    <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Ui.TextSecondary}" FontSize="12">
      <Run Text="The app lives in the notification area. Right-click its icon for settings, per-application pauses and diagnostics." />
      <LineBreak />
      <Run Text="Only the selected text is sent to the translation service. No history is kept." />
    </TextBlock>

    <TextBlock x:Name="HookWarning" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Ui.Error}" FontSize="12" Visibility="Collapsed" />

    <DockPanel Margin="0,20,0,0">
      <CheckBox x:Name="DontShowBox" Content="Don't show this again" IsChecked="True" VerticalAlignment="Center" Style="{StaticResource UiCheckBox}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource SecondaryButton}" Content="Settings…" Margin="0,0,8,0" Click="OnSettings" />
        <Button Style="{StaticResource PrimaryButton}" Content="Start reading" Click="OnClose" IsDefault="True" />
      </StackPanel>
    </DockPanel>
  </StackPanel>
</Window>
