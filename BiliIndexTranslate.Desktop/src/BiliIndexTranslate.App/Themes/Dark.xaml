<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Warm dark palette mirroring Light.xaml. -->
  <SolidColorBrush x:Key="Popup.Surface" Color="#262321" />
  <SolidColorBrush x:Key="Popup.SurfaceAlt" Color="#2E2A27" />
  <SolidColorBrush x:Key="Popup.Border" Color="#3D3833" />
  <SolidColorBrush x:Key="Popup.Divider" Color="#36322E" />
  <SolidColorBrush x:Key="Popup.Text" Color="#EAE5DE" />
  <SolidColorBrush x:Key="Popup.TextSecondary" Color="#A8A198" />
  <SolidColorBrush x:Key="Popup.TextFaint" Color="#7C766E" />
  <SolidColorBrush x:Key="Popup.Accent" Color="#E09A75" />
  <SolidColorBrush x:Key="Popup.AccentSoft" Color="#3B2E27" />
  <SolidColorBrush x:Key="Popup.Error" Color="#E08A7B" />
  <SolidColorBrush x:Key="Popup.Hover" Color="#36312D" />
  <SolidColorBrush x:Key="Popup.Pressed" Color="#403A35" />
  <SolidColorBrush x:Key="Popup.ScrollThumb" Color="#5A534C" />
  <SolidColorBrush x:Key="Popup.PinnedBorder" Color="#6B4F42" />
  <Color x:Key="Popup.ShadowColor">#000000</Color>
  <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Popup.ShadowOpacity">0.45</sys:Double>

  <SolidColorBrush x:Key="Ui.Background" Color="#232120" />
  <SolidColorBrush x:Key="Ui.Panel" Color="#2B2825" />
  <SolidColorBrush x:Key="Ui.Text" Color="#EAE5DE" />
  <SolidColorBrush x:Key="Ui.TextSecondary" Color="#A8A198" />
  <SolidColorBrush x:Key="Ui.Border" Color="#443E39" />
  <SolidColorBrush x:Key="Ui.Accent" Color="#E09A75" />
  <SolidColorBrush x:Key="Ui.AccentText" Color="#1E1B19" />
  <SolidColorBrush x:Key="Ui.Control" Color="#312D2A" />
  <SolidColorBrush x:Key="Ui.Success" Color="#8CC49A" />
  <SolidColorBrush x:Key="Ui.Error" Color="#E08A7B" />
</ResourceDictionary>
